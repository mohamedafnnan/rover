---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortalCard from '../components/PortalCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { hero, mission, verifiedSpecs, departments, sponsors, achievements, gallery, siteMeta, contact } from '../data/site';
---
<BaseLayout title="FISAT Rover Team — DAWN" description={siteMeta.description} path="/">
  <section class="relative overflow-hidden border-b border-line/60">
    <video class="absolute inset-0 h-full w-full object-cover opacity-20" autoplay muted loop playsinline poster="/fisat/images/Robo/about1.jpg">
      <source src={hero.backgroundVideo} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,122,47,.18),transparent_30%),linear-gradient(180deg,rgba(6,7,11,.25),rgba(6,7,11,.95))]"></div>
    <div class="shell relative py-16 md:py-28">
      <div class="max-w-4xl">
        <div class="kicker">{hero.eyebrow}</div>
        <div class="mt-6 inline-flex items-center gap-3 rounded-full border border-orange/25 bg-orange/10 px-4 py-2 text-sm font-semibold text-orange-soft">{hero.kicker} <span class="h-1.5 w-1.5 rounded-full bg-orange"></span> Mars rover prototype</div>
        <h1 class="h1 mt-6">Planetary robotics, presented like a serious engineering program.</h1>
        <p class="lead mt-6 max-w-2xl">{hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={hero.primaryCta.href} class="btn-primary">{hero.primaryCta.label}</a>
          <a href={hero.secondaryCta.href} class="btn-secondary">{hero.secondaryCta.label}</a>
          <a href={hero.tertiaryCta.href} class="btn-secondary">{hero.tertiaryCta.label}</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-4">
        <div class="metric"><div class="metric-value">DAWN</div><div class="metric-label">Official rover name</div></div>
        <div class="metric"><div class="metric-value">IRC 2026</div><div class="metric-label">Current public campaign</div></div>
        <div class="metric"><div class="metric-value">FISAT</div><div class="metric-label">Federal Institute of Science and Technology</div></div>
        <div class="metric"><div class="metric-value">Kerala</div><div class="metric-label">Angamaly, India</div></div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
      <article class="glass-strong rounded-[28px] p-7 md:p-9">
        <div class="eyebrow">About the mission</div>
        <h2 class="h2 mt-3">{mission.aboutTitle}</h2>
        <p class="lead mt-5">{mission.about}</p>
        <div class="mt-6 grid gap-3 md:grid-cols-3">
          <div class="rounded-[18px] border border-line bg-white/4 p-4"><div class="text-xs uppercase tracking-[0.24em] text-faint">Institution</div><div class="mt-2 font-semibold">{mission.institution}</div></div>
          <div class="rounded-[18px] border border-line bg-white/4 p-4"><div class="text-xs uppercase tracking-[0.24em] text-faint">Location</div><div class="mt-2 font-semibold">{mission.location}</div></div>
          <div class="rounded-[18px] border border-line bg-white/4 p-4"><div class="text-xs uppercase tracking-[0.24em] text-faint">Competition</div><div class="mt-2 font-semibold">{mission.competition}</div></div>
        </div>
      </article>
      <article class="glass rounded-[28px] p-7 md:p-9">
        <div class="eyebrow">Built differently</div>
        <h2 class="h2 mt-3">{mission.builtTitle}</h2>
        <p class="lead mt-5">{mission.built}</p>
        <img src="/fisat/images/Robo/gal1.jpg" alt="DAWN rover detail" class="mt-6 h-72 w-full rounded-[22px] border border-line object-cover" />
      </article>
    </div>
  </section>

  <section class="pb-8">
    <div class="shell">
      <SectionHeading eyebrow="Verified public engineering signals" title="A rover brief that stays inside the published facts." description="The live interface avoids speculative subsystem claims. Every item below is drawn from the official site copy, team modal descriptions, or the FISAT event page." />
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {verifiedSpecs.slice(0, 4).map((spec) => (
          <article class="glass rounded-[22px] p-5 card-hover">
            <div class="text-xs uppercase tracking-[0.24em] text-orange-soft">{spec.label}</div>
            <div class="mt-3 font-display text-2xl leading-tight">{spec.value}</div>
            <div class="mt-4 text-xs uppercase tracking-[0.2em] text-faint">Source · {spec.source}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <SectionHeading eyebrow="Engineering groups" title="Multidisciplinary team structure, shown without fake subsystem theatre." description="Department cards are based on the official site’s public descriptions and verified role labels from the team roster." />
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {departments.slice(0, 4).map((dept) => (
          <article class="glass rounded-[22px] p-6 card-hover">
            <div class="kicker">{dept.name}</div>
            <p class="copy mt-5">{dept.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-10">
    <div class="shell grid gap-6 lg:grid-cols-[.85fr_1.15fr]">
      <div class="glass rounded-[28px] p-7 md:p-8">
        <SectionHeading eyebrow="Competition track" title="IRC 2026" description="The competition view keeps the public narrative concise: campaign context, Day 01 field notes, and clearly flagged gaps for unverified details." />
        <div class="mt-6 space-y-4">
          {achievements.slice(0, 3).map((item) => (
            <article class="rounded-[18px] border border-line bg-white/4 p-4">
              <h3 class="text-lg font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm leading-7 text-muted">{item.body}</p>
              <a href={item.source} target="_blank" rel="noreferrer" class="mt-3 inline-flex text-xs uppercase tracking-[0.24em] text-orange-soft">Source ↗</a>
            </article>
          ))}
        </div>
      </div>
      <PortalCard />
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <SectionHeading eyebrow="Sponsors" title="A compact sponsor teaser on the homepage, with the full tier hierarchy moved to its own page." description="This reduces homepage scroll length while keeping partner visibility strong." />
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {sponsors.flatMap((tier) => tier.items).slice(0, 4).map((item) => (
          <a href={item.url} target="_blank" rel="noreferrer" class="glass rounded-[20px] p-5 card-hover">
            <div class="flex min-h-20 items-center justify-center rounded-[18px] border border-line bg-white/5 p-5">
              <img src={item.logo} alt={item.name} class="max-h-12 w-auto object-contain" loading="lazy" />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-text">{item.name}</h3>
          </a>
        ))}
      </div>
      <div class="mt-6 flex justify-center"><a href="/sponsors" class="btn-secondary">View sponsor tiers</a></div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <SectionHeading eyebrow="Gallery" title="Official rover and campaign imagery" description="The image set combines the official rover site images with publicly posted FISAT event coverage for IRC 2026." />
      <div class="mt-8">
        <GalleryGrid items={gallery.slice(0, 6)} />
      </div>
      <div class="mt-6 flex justify-center"><a href="/gallery" class="btn-secondary">Open full gallery</a></div>
    </div>
  </section>

  <section class="pb-20">
    <div class="shell">
      <div class="glass-strong rounded-[28px] p-7 md:p-10">
        <div class="grid gap-8 md:grid-cols-[1.1fr_.9fr] md:items-center">
          <div>
            <div class="eyebrow">Contact</div>
            <h2 class="h2 mt-3">Public contact stays simple and credible.</h2>
            <p class="lead mt-5">For outreach, sponsorship, or team communication, the public site should point visitors to verified institutional and social channels rather than invented forms or fake workflows.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={`mailto:${contact.email}`} class="btn-primary">Email the team</a>
              <a href={contact.instagram} target="_blank" rel="noreferrer" class="btn-secondary">Instagram</a>
              <a href={contact.linkedin} target="_blank" rel="noreferrer" class="btn-secondary">LinkedIn</a>
            </div>
          </div>
          <div class="rounded-[24px] border border-line bg-white/4 p-6">
            <div class="text-xs uppercase tracking-[0.24em] text-faint">Public address</div>
            <p class="mt-3 text-base leading-7 text-text">{contact.address}</p>
            <div class="mt-5 text-xs uppercase tracking-[0.24em] text-faint">Official email</div>
            <p class="mt-3 text-base text-text">{contact.email}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
