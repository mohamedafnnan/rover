---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
const centered = align === 'center';
---
<div class:list={["max-w-3xl", centered && "mx-auto text-center"]}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <h2 class="h2 mt-3">{title}</h2>
  {description && <p class="lead mt-4">{description}</p>}
</div>
